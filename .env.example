# ===== AgentQA Cloud — copy to .env and fill in. NEVER commit .env. =====

# ---- AI (Gemini) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TEMPERATURE=0.4

# ---- Database ----
# Local (no Docker):  postgresql+asyncpg://USER:PASSWORD@localhost:5432/agentqa
# Quick trial:        sqlite+aiosqlite:///./dev.db
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# Used by docker compose only
POSTGRES_USER=agentqa
POSTGRES_PASSWORD=
POSTGRES_DB=agentqa

# ---- Redis: optional / not used by default (live events use an in-process bus) ----
REDIS_URL=

# ---- Run limits (per-run values from the UI are clamped server-side) ----
MAX_STEPS=100
MAX_RUNTIME=900
MAX_DEPTH=6
MAX_RETRIES=1
MAX_CONCURRENT_BROWSERS=1

# ---- Browser ----
BROWSER_HEADLESS=true
BROWSER_MAX_SESSIONS=2

# ---- Security ----
# Comma-separated allowlist. Empty = any PUBLIC domain. Subdomains are included.
ALLOWED_DOMAINS=
# Localhost / private IPs are blocked by default (SSRF protection). Set true ONLY to test your own local apps.
BROWSER_ALLOW_PRIVATE_NETWORKS=false
BACKEND_CORS_ORIGINS=http://localhost:5173
# Raw browser/LLM debug endpoints (/api/browser, /api/ai). Leave false.
ENABLE_DEBUG_ENDPOINTS=false

# ---- Optional features ----
# Candidate-fix suggestions (proposes diffs only, never edits code)
FIX_AGENT_ENABLED=false

# ---- Data retention ----
MAX_ARTIFACT_SIZE=200          # MB per run
MAX_SCREENSHOTS_PER_RUN=150
RUN_RETENTION_DAYS=30          # 0 = keep forever

# ---- Storage / misc ----
AUTO_CREATE_SCHEMA=true        # dev convenience; Docker uses Alembic
SCREENSHOT_DIR=./data/artifacts/screenshots
TRACE_DIR=./data/artifacts/traces
DOM_SNAPSHOT_DIR=./data/artifacts/dom
LOG_LEVEL=INFO
ENVIRONMENT=development

# ---- Frontend (build-time, PUBLIC — never put secrets here). Put in frontend/.env ----
VITE_API_URL=http://localhost:8000
